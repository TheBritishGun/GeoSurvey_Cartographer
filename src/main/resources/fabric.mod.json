{
  "schemaVersion": 1,
  "id": "openmap-collect",
  "version": "${version}",
  "name": "GeoSurvey Cartographer",
  "description": "Contributes surveyed ground to a shared map; with claim greetings on, it draws greetings from web maps and avience.live. Use it beside another map mod, such as Xaero's or JourneyMap, and instead of the GeoSurvey map mod. Not an official Minecraft product. Not approved by or associated with Mojang or Microsoft.",
  "license": "AGPL-3.0-or-later",
  "icon": "assets/openmap-collect/icon.png",
  "authors": ["BritishGun"],
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.openmap.client.CollectorMod"
    ],
    "modmenu": [
      "dev.openmap.client.CollectorModMenu"
    ],
    "sandpaper-settings": [
      "dev.openmap.client.CollectorOptions"
    ]
  },
  "mixins": [
    "openmap-collect.mixins.json"
  ],
  "jars": [
    { "file": "META-INF/jars/${sandpaper_jar}" }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*",
    "sandpaper": ">=${sandpaper_version}"
  },
  "breaks": {
    "geosurvey": "<0.1.12-i"
  },
  "suggests": {
    "modmenu": "*"
  }
}
